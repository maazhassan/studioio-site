---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/portfolio/*.jpg',
  { eager: true },
);
const photos = Object.values(modules).map(m => m.default);
---

<BaseLayout
  title="Contact"
  description="Get in touch with Studio.io to book your wedding photography session."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6">

    <!-- Page heading -->
    <div class="pt-10 md:pt-14 pb-12 text-center">
      <h1 class="font-serif text-5xl md:text-6xl text-coffee-bean">Contact</h1>
    </div>

    <!-- Photo + blurb -->
    <section class="flex flex-col items-center sm:flex-row sm:items-start gap-8 sm:gap-10 mb-16 md:mb-20">
      <div class="w-40 sm:w-44 shrink-0">
        <div class="relative aspect-3/4 overflow-hidden">
          <Image
            src={photos[0]}
            alt="Studio.io photography"
            width={176}
            height={234}
            loading="eager"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      </div>

      <div class="text-center sm:text-left">
        <p class="font-sans text-xs tracking-widest uppercase text-olive mb-3">Get in Touch</p>
        <h2 class="font-serif text-3xl md:text-4xl text-coffee-bean leading-tight mb-4">
          Let's Create<br class="hidden sm:block" /> Something Beautiful
        </h2>
        <p class="font-sans text-sm text-coffee-bean/65 leading-relaxed">
          Whether you're planning a wedding, a family session, or a portrait shoot, we'd love to hear from you.
          Take a look at our
          <a href="/services" class="text-muted-teal underline underline-offset-2 hover:text-coffee-bean transition-colors duration-200">
            services
          </a>
          to find the right fit, then send us a message below.
        </p>
      </div>
    </section>

    <!-- Form section -->
    <section class="mb-20 md:mb-28">
      <h2 class="font-serif text-4xl md:text-5xl text-coffee-bean text-center mb-10 md:mb-12">
        Send a Message
      </h2>

      <form id="contact-form" class="space-y-8" novalidate>

        <!-- Name + Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <div>
            <label for="name" class="block font-sans text-xs tracking-widest uppercase text-coffee-bean/60 mb-3">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder="Your full name"
              class="w-full bg-transparent border-b border-coffee-bean/25 pb-2.5 font-sans text-sm text-coffee-bean placeholder:text-coffee-bean/30 focus:outline-none focus:border-muted-teal transition-colors duration-200"
            />
          </div>
          <div>
            <label for="email" class="block font-sans text-xs tracking-widest uppercase text-coffee-bean/60 mb-3">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="your@email.com"
              class="w-full bg-transparent border-b border-coffee-bean/25 pb-2.5 font-sans text-sm text-coffee-bean placeholder:text-coffee-bean/30 focus:outline-none focus:border-muted-teal transition-colors duration-200"
            />
          </div>
        </div>

        <!-- Phone -->
        <div>
          <label for="phone" class="block font-sans text-xs tracking-widest uppercase text-coffee-bean/60 mb-3">
            Phone Number
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            autocomplete="tel"
            placeholder="+1 (000) 000-0000"
            class="w-full bg-transparent border-b border-coffee-bean/25 pb-2.5 font-sans text-sm text-coffee-bean placeholder:text-coffee-bean/30 focus:outline-none focus:border-muted-teal transition-colors duration-200"
          />
        </div>

        <!-- Event Type -->
        <div class="relative">
          <label for="event-type" class="block font-sans text-xs tracking-widest uppercase text-coffee-bean/60 mb-3">
            Event Type
          </label>
          <select
            id="event-type"
            name="eventType"
            required
            class="w-full bg-transparent border-b border-coffee-bean/25 pb-2.5 font-sans text-sm focus:outline-none focus:border-muted-teal transition-colors duration-200 appearance-none cursor-pointer pr-8"
          >
            <option value="" disabled selected>Select an event type</option>
            <option value="Wedding">Wedding</option>
            <option value="Graduation">Graduation</option>
            <option value="Corporate / Event">Corporate / Event</option>
            <option value="Family">Family</option>
            <option value="Portraits">Portraits</option>
            <option value="Other">Other</option>
          </select>
          <!-- Chevron -->
          <svg
            class="absolute right-0 bottom-3 w-4 h-4 text-coffee-bean/40 pointer-events-none"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="block font-sans text-xs tracking-widest uppercase text-coffee-bean/60 mb-3">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder="Tell us about your event, the date, and any details you'd like to share..."
            class="w-full bg-transparent border-b border-coffee-bean/25 pb-2.5 font-sans text-sm text-coffee-bean placeholder:text-coffee-bean/30 focus:outline-none focus:border-muted-teal transition-colors duration-200 resize-none"
          ></textarea>
        </div>

        <!-- Submit -->
        <div class="text-center pt-2">
          <button
            id="submit-btn"
            type="submit"
            disabled
            class="hover:cursor-pointer inline-flex items-center gap-3 border px-8 py-3.5 font-sans text-xs tracking-widest uppercase transition-all duration-300
              border-coffee-bean text-coffee-bean hover:border-muted-teal hover:bg-muted-teal hover:text-papaya-whip
              disabled:border-coffee-bean/25 disabled:text-coffee-bean/30 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:border-coffee-bean/25 disabled:hover:text-coffee-bean/30"
          >
            Send Message
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
            </svg>
          </button>
        </div>

      </form>

      <!-- Success message -->
      <div id="success-msg" class="hidden text-center py-16">
        <p class="font-sans text-xs tracking-widest uppercase text-olive mb-5">Message Sent</p>
        <h2 class="font-serif text-4xl md:text-5xl text-coffee-bean mb-5">Thank You</h2>
        <p class="font-sans text-sm text-coffee-bean/65 leading-relaxed max-w-sm mx-auto">
          We'll be in touch soon.
        </p>
      </div>

    </section>

  </div>
</BaseLayout>

<style>
  /* Select placeholder vs chosen value color */
  select#event-type {
    color: rgba(28, 0, 0, 0.3);
  }
  select#event-type.has-value {
    color: var(--color-coffee-bean);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-msg') as HTMLDivElement;
  const select = document.getElementById('event-type') as HTMLSelectElement;

  const fields = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
    'input[required], select[required], textarea[required]'
  );

  function checkAllFilled() {
    const allFilled = Array.from(fields).every(f => f.value.trim() !== '');
    btn.disabled = !allFilled;
  }

  fields.forEach(f => f.addEventListener('input', checkAllFilled));

  select.addEventListener('change', () => {
    select.classList.add('has-value');
    checkAllFilled();
  });

  form.addEventListener('submit', async e => {
    e.preventDefault();

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const eventType = select.value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const res = await fetch('/submit-form', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, phone, eventType, message }),
      });

      if (!res.ok) {
        const { error } = await res.json() as { error?: string };
        throw new Error(error ?? 'Something went wrong.');
      }

      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = `Send Message <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>`;
      const msg = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
      alert(msg);
    }
  });
</script>
