---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ogPhoto from '../assets/images/portfolio/rt_10.webp';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/portfolio/*.{jpg,jpeg,JPG,webp}',
  { eager: true },
);

const slideshowFilenames = [
  'rt_10.webp',
  'rt_60.webp',
  'rt_7.webp',
  'rt_52.webp',
  'rt_15.webp',
  'rt_16.webp',
  'rt_18.webp',
  'rt_53.webp',
  'rt_30.webp',
  'rt_31.webp',
  'rt_43.webp',
  'rt_49.webp',
  'rt_61.webp',
  'rt_63.webp',
  '_A740975.jpg',
  '_A741272.jpg',
  '_A740223.jpg',
  '_A740445.jpg',
  '_A741283.jpg',
  '_A741295.jpg',
];

const photos = slideshowFilenames.map(
  filename => modules[`../assets/images/portfolio/${filename}`].default,
);
---

<BaseLayout
  title="Home"
  description="Studio.io — Timeless wedding photography capturing every precious moment of your special day."
  ogImage={ogPhoto.src}
>
  <div class="max-w-6xl mx-auto px-2 sm:px-3">

    <!-- Slideshow -->
    <section aria-label="Featured photography" class="pt-6 md:pt-10">
      <div
        id="slideshow"
        class="relative overflow-hidden bg-coffee-bean"
        style="height: 60vw; max-height: 85vh; min-height: 300px;"
      >
        <!-- Slides -->
        {photos.map((photo, i) => (
          <div
            class="slide absolute inset-0"
            data-index={i}
            aria-hidden={i !== 0}
            style={i === 0 ? 'transform:translateX(0%);z-index:1;' : 'transform:translateX(100%);z-index:0;'}
          >
            <Image
              src={photo}
              alt={`Studio.io wedding photography, image ${i + 1}`}
              width={1600}
              height={1067}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="w-full h-full object-cover"
            />
          </div>
        ))}

        <!-- Prev arrow -->
        <button
          id="slide-prev"
          aria-label="Previous photo"
          class="absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-coffee-bean/40 hover:bg-coffee-bean/70 text-papaya-whip transition-colors duration-200 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
          </svg>
        </button>

        <!-- Next arrow -->
        <button
          id="slide-next"
          aria-label="Next photo"
          class="absolute right-3 sm:right-5 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-coffee-bean/40 hover:bg-coffee-bean/70 text-papaya-whip transition-colors duration-200 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>

        <!-- Dot indicators -->
        <div id="slide-dots" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex gap-2" aria-hidden="true"></div>
      </div>
    </section>

    <!-- View Full Portfolio -->
    <div class="mt-7 text-center">
      <a
        href="/portfolio"
        class="inline-flex items-center gap-3 border border-coffee-bean text-coffee-bean px-8 py-3.5 font-sans text-xs tracking-widest uppercase transition-colors duration-300 hover:border-muted-teal hover:bg-muted-teal hover:text-papaya-whip"
      >
        View Full Portfolio
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
        </svg>
      </a>
    </div>

    <!-- Blurb -->
    <section class="max-w-lg mx-auto py-20 md:py-28 text-center">

      <p class="font-sans text-xs tracking-widest uppercase text-olive mb-6">
        Wedding & Event Photography
      </p>

      <h1 class="font-serif text-5xl md:text-6xl text-coffee-bean leading-[1.1] mb-8">
        Capturing Your<br />Special Moment
      </h1>

      <p class="font-sans text-sm text-coffee-bean/65 leading-relaxed mb-12">
        We help you remember by creating timeless images that celebrate your story with authenticity, professionalism, and lasting quality.
      </p>

      <a
        href="/contact"
        class="inline-flex items-center gap-3 border border-coffee-bean text-coffee-bean px-8 py-3.5 font-sans text-xs tracking-widest uppercase transition-colors duration-300 hover:border-muted-teal hover:bg-muted-teal hover:text-papaya-whip"
      >
        Inquire Now
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
        </svg>
      </a>

    </section>

  </div>
</BaseLayout>

<style>
  .slide {
    will-change: transform;
  }
</style>

<script>
  const INTERVAL_MS = 2500;
  const DURATION_MS = 700;

  const container = document.getElementById('slideshow')!;
  const slides = Array.from(container.querySelectorAll<HTMLElement>('.slide'));
  const dotsContainer = document.getElementById('slide-dots')!;
  const prevBtn = document.getElementById('slide-prev')!;
  const nextBtn = document.getElementById('slide-next')!;

  const order: number[] = Array.from({ length: slides.length }, (_, idx) => idx);

  // First in order goes to position 0, rest offscreen right
  slides.forEach((s, i) => {
    s.style.transition = 'none';
    s.style.transform = 'translateX(100%)';
    s.style.zIndex = '0';
    s.setAttribute('aria-hidden', 'true');
  });
  slides[order[0]].style.transform = 'translateX(0%)';
  slides[order[0]].style.zIndex = '1';
  slides[order[0]].setAttribute('aria-hidden', 'false');

  // Build dots
  const dots: HTMLButtonElement[] = order.map((_, i) => {
    const dot = document.createElement('button');
    dot.className = [
      'w-1.5 h-1.5 rounded-full transition-all duration-300',
      i === 0
        ? 'bg-papaya-whip scale-125'
        : 'bg-papaya-whip/40 hover:bg-papaya-whip/70',
    ].join(' ');
    dot.setAttribute('aria-label', `Go to photo ${i + 1}`);
    dot.addEventListener('click', () => goTo(i));
    dotsContainer.appendChild(dot);
    return dot;
  });

  let current = 0;
  let animating = false;
  let timer: ReturnType<typeof setInterval>;

  function setActiveDot(idx: number) {
    dots.forEach((d, i) => {
      if (i === idx) {
        d.className = 'w-1.5 h-1.5 rounded-full transition-all duration-300 bg-papaya-whip scale-125';
      } else {
        d.className = 'w-1.5 h-1.5 rounded-full transition-all duration-300 bg-papaya-whip/40 hover:bg-papaya-whip/70';
      }
    });
  }

  function goTo(nextPos: number, direction?: 'forward' | 'backward') {
    if (animating || nextPos === current) return;
    animating = true;

    const dir = direction ?? (nextPos > current ? 'forward' : 'backward');
    const inFrom = dir === 'forward' ? '100%' : '-100%';
    const outTo  = dir === 'forward' ? '-100%' : '100%';

    const currentSlide = slides[order[current]];
    const nextSlide    = slides[order[nextPos]];

    // Snap next slide into start position without transition
    nextSlide.style.transition = 'none';
    nextSlide.style.transform = `translateX(${inFrom})`;
    nextSlide.style.zIndex = '2';
    nextSlide.setAttribute('aria-hidden', 'false');

    // Force reflow so the snap registers before the animation begins
    void nextSlide.offsetWidth;

    // Animate both slides
    const easing = 'cubic-bezier(0.45, 0, 0.55, 1)';
    nextSlide.style.transition = `transform ${DURATION_MS}ms ${easing}`;
    nextSlide.style.transform = 'translateX(0%)';

    currentSlide.style.transition = `transform ${DURATION_MS}ms ${easing}`;
    currentSlide.style.transform = `translateX(${outTo})`;

    setTimeout(() => {
      currentSlide.style.zIndex = '0';
      currentSlide.setAttribute('aria-hidden', 'true');
      current = nextPos;
      animating = false;
    }, DURATION_MS);

    setActiveDot(nextPos);
  }

  function advance() {
    goTo((current + 1) % order.length, 'forward');
  }

  function startTimer() {
    timer = setInterval(advance, INTERVAL_MS);
  }

  function resetTimer() {
    clearInterval(timer);
    startTimer();
  }

  prevBtn.addEventListener('click', () => {
    goTo((current - 1 + order.length) % order.length, 'backward');
    resetTimer();
  });

  nextBtn.addEventListener('click', () => {
    goTo((current + 1) % order.length, 'forward');
    resetTimer();
  });

  // Pause on hover
  container.addEventListener('mouseenter', () => clearInterval(timer));
  container.addEventListener('mouseleave', resetTimer);

  // Swipe support for mobile
  let touchStartX = 0;
  container.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  container.addEventListener('touchend', (e) => {
    const delta = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 50) {
      if (delta > 0) {
        goTo((current + 1) % order.length, 'forward');
      } else {
        goTo((current - 1 + order.length) % order.length, 'backward');
      }
      resetTimer();
    }
  }, { passive: true });

  startTimer();
</script>
