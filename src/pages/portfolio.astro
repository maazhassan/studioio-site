---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/portfolio/*.{jpg,JPG,jpeg,JPEG}',
  { eager: true },
);

const byName: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(modules)) {
  const basename = path.split('/').pop()!;
  byName[basename] = mod.default;
}

// A740980 is not present in assets — skipped
const columns = [
  {
    widthPx: 350,
    files: [
      '_A740217.jpg', '_A741207.jpg', 'DSC00057.JPG', '_A740445.jpg',
      '_A740991.jpg', '_A740965.jpg', '_A740975.jpg', '_A741272.jpg', '_A741263.jpg',
      '_A741295.jpg', '123.jpeg', '_A740223.jpg',
    ],
  },
  {
    widthPx: 428,
    files: [
      '_A740908.jpg', '_A740403.jpg', '_A741793.jpg', '_A741283.jpg',
      '_A741013.jpg', '_A740935.jpg', '_A741772.jpg', '_A740912.jpg',
      'DSC00144.JPG', '_A741315.jpg', '_A740909.jpg',
    ],
  },
  {
    widthPx: 350,
    files: [
      '_A740960.jpg', '_A741957.jpg', '_A741276.jpg', '_A741053.jpg',
      'DSC00168.JPG', '_A740956.jpg', '_A741045.jpg', 'DSC00175.JPG',
      '_A741969.jpg', '_A740944.jpg', 'DSC00044.JPG',
    ],
  },
];

// Flatten for lightbox indexing (left → middle → right, top → bottom)
const flatPhotos = columns.flatMap(col =>
  col.files.filter(f => byName[f]).map(file => ({ file, widthPx: col.widthPx }))
);

const largePhotos = await Promise.all(
  flatPhotos.map(({ file }) =>
    getImage({ src: byName[file], width: 1200, format: 'webp', quality: 85 })
  )
);

// Map file → lightbox index
const lightboxIdx: Record<string, number> = {};
flatPhotos.forEach(({ file }, i) => { lightboxIdx[file] = i; });

let eagerCount = 0;
---

<BaseLayout
  title="Portfolio"
  description="Browse the Studio.io portfolio — a collection of cherished moments and beautiful love stories."
>
  <div class="max-w-300 mx-auto px-2 sm:px-4">

    <!-- Heading -->
    <div class="pt-10 md:pt-14 pb-8 text-center">
      <h1 class="font-serif text-5xl md:text-6xl text-coffee-bean">Portfolio</h1>
    </div>

    <!-- Grid -->
    <section aria-label="Portfolio gallery">
      <div class="flex flex-col md:flex-row md:justify-center gap-1.5">
        {columns.map((col) => (
          <div
            class="flex flex-col gap-1.5 w-full md:shrink-0"
            style={`--col-w: ${col.widthPx}px`}
          >
            {col.files.filter(f => byName[f]).map((file) => {
              const idx = lightboxIdx[file];
              const large = largePhotos[idx];
              const photo = byName[file];
              const isEager = eagerCount++ < 6;
              return (
                <button
                  type="button"
                  class="block overflow-hidden group cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-amber-flame"
                  data-lightbox-trigger
                  data-src={large.src}
                  data-alt={`Studio.io wedding photography`}
                  aria-label={`View photo`}
                  aria-haspopup="dialog"
                >
                  <Image
                    src={photo}
                    alt=""
                    aria-hidden="true"
                    width={col.widthPx * 2}
                    loading={isEager ? 'eager' : 'lazy'}
                    class="w-full h-auto block transition-transform duration-700 ease-out group-hover:scale-105 pointer-events-none select-none"
                  />
                </button>
              );
            })}
          </div>
        ))}
      </div>
    </section>

    <div class="h-16 md:h-20"></div>

  </div>

  <!-- ─── Lightbox ─────────────────────────────────────────────────────────── -->
  <div
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
    class="hidden fixed inset-0 z-200 backdrop-blur-3xl bg-papaya-whip/50"
  >
    <div class="absolute inset-0 flex items-center justify-between px-3 md:px-6 pointer-events-none">

      <button
        id="lightbox-prev"
        type="button"
        aria-label="Previous photo"
        class="pointer-events-auto shrink-0 p-3 bg-white/25 hover:bg-white/50 backdrop-blur-sm text-coffee-bean rounded-full transition-colors duration-200 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>

      <div
        id="lightbox-panel"
        class="pointer-events-auto flex-1 flex flex-col items-center mx-3 md:mx-6 min-w-0"
      >
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[88vh] w-auto max-w-full object-contain drop-shadow-2xl"
        />
      </div>

      <button
        id="lightbox-next"
        type="button"
        aria-label="Next photo"
        class="pointer-events-auto shrink-0 p-3 bg-white/25 hover:bg-white/50 backdrop-blur-sm text-coffee-bean rounded-full transition-colors duration-200 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>

    </div>

    <button
      id="lightbox-close"
      type="button"
      aria-label="Close photo viewer"
      class="absolute top-4 right-4 z-10 p-2.5 bg-white/25 hover:bg-white/50 backdrop-blur-sm text-coffee-bean rounded-full transition-colors duration-200 cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

  </div>

  <style>
    @media (min-width: 768px) {
      [style*="--col-w"] {
        width: var(--col-w);
      }
    }
  </style>

  <script>
    const lightbox  = document.getElementById('lightbox')!;
    const img       = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn  = document.getElementById('lightbox-close')!;
    const prevBtn   = document.getElementById('lightbox-prev')!;
    const nextBtn   = document.getElementById('lightbox-next')!;

    const triggers  = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'));
    let currentIdx  = 0;
    let lastFocused: HTMLElement | null = null;

    function show(idx: number) {
      currentIdx = (idx + triggers.length) % triggers.length;
      const t = triggers[currentIdx];
      img.src = t.dataset.src ?? '';
      img.alt = t.dataset.alt ?? '';
    }

    function open(trigger: HTMLElement) {
      lastFocused = trigger;
      show(triggers.indexOf(trigger));
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    triggers.forEach(el => el.addEventListener('click', () => open(el)));

    // Click anywhere on the lightbox closes it; stop propagation on the image and nav buttons
    lightbox.addEventListener('click', close);
    img.addEventListener('click', e => e.stopPropagation());
    prevBtn.addEventListener('click', e => { e.stopPropagation(); show(currentIdx - 1); });
    nextBtn.addEventListener('click', e => { e.stopPropagation(); show(currentIdx + 1); });
    closeBtn.addEventListener('click', e => { e.stopPropagation(); close(); });

    document.addEventListener('keydown', e => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape')      { close(); }
      if (e.key === 'ArrowLeft')   { e.preventDefault(); show(currentIdx - 1); }
      if (e.key === 'ArrowRight')  { e.preventDefault(); show(currentIdx + 1); }
    });

    lightbox.addEventListener('keydown', e => {
      if (e.key !== 'Tab' || lightbox.classList.contains('hidden')) return;
      const focusable = Array.from(
        lightbox.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])',
        ),
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last  = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    });
  </script>

</BaseLayout>
