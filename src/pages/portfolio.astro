---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/portfolio/*.jpg',
  { eager: true },
);
const photos = Object.values(modules).map(m => m.default);

// Pre-generate large versions for lightbox (one per unique source image)
const largePhotos = await Promise.all(
  photos.map(photo => getImage({ src: photo, width: 900, format: 'webp', quality: 85 }))
);

// 24-slot grid with a 12-item repeating pattern (desktop 3-col):
//   Row A: P · P · P          (indices 0,1,2  mod 12)
//   Row B: L·· · P            (indices 3,4    mod 12 — 3 is wide)
//   Row C: P · L··            (indices 5,6    mod 12 — 6 is wide)
//   Row D: P · P · P          (indices 7,8,9  mod 12)
//   Row E: L·· · P            (indices 10,11  mod 12 — 10 is wide)
const TOTAL = 24;

function colClass(i: number): string {
  return [3, 6, 10].includes(i % 12) ? 'col-span-1 md:col-span-2' : 'col-span-1';
}

const captions = [
  'A quiet moment before the ceremony.',
  'The light through the chapel windows.',
  'Details that tell your story.',
  'Golden hour, just the two of you.',
  'A celebration of love and family.',
  'First dance under the stars.',
  'Laughter shared between friends.',
  'The vows that started everything.',
];
---

<BaseLayout
  title="Portfolio"
  description="Browse the Studio.io portfolio — a collection of cherished moments and beautiful love stories."
>
  <div class="max-w-6xl mx-auto px-2 sm:px-3">

    <!-- Heading -->
    <div class="pt-10 md:pt-14 pb-8 text-center">
      <h1 class="font-serif text-5xl md:text-6xl text-coffee-bean">Portfolio</h1>
    </div>

    <!-- Grid -->
    <section aria-label="Portfolio gallery">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-1.5 auto-rows-[270px] md:auto-rows-[390px]">
        {Array.from({ length: TOTAL }, (_, i) => {
          const photoIdx = i % photos.length;
          return (
            <button
              type="button"
              class:list={[
                'overflow-hidden group cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-amber-flame',
                colClass(i),
              ]}
              data-lightbox-trigger
              data-src={largePhotos[photoIdx].src}
              data-alt={`Studio.io wedding photography, image ${i + 1}`}
              data-desc={captions[i % captions.length]}
              aria-label={`View photo ${i + 1}`}
              aria-haspopup="dialog"
            >
              <Image
                src={photos[photoIdx]}
                alt=""
                aria-hidden="true"
                width={678}
                height={1024}
                loading={i < 6 ? 'eager' : 'lazy'}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 pointer-events-none select-none"
              />
            </button>
          );
        })}
      </div>
    </section>

    <div class="h-16 md:h-20"></div>

  </div>

  <!-- ─── Lightbox ─────────────────────────────────────────────────────────── -->
  <div
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
    class="hidden fixed inset-0 z-200 backdrop-blur-3xl bg-papaya-whip/50"
  >
    <!-- Transparent backdrop — clicking here closes the dialog -->
    <button
      id="lightbox-backdrop"
      type="button"
      aria-label="Close photo viewer"
      class="absolute inset-0 w-full cursor-zoom-out"
    ></button>

    <!-- Controls layer — pointer-events-none so backdrop receives stray clicks -->
    <div class="absolute inset-0 flex items-center justify-between px-3 md:px-6 pointer-events-none">

      <!-- Prev arrow -->
      <button
        id="lightbox-prev"
        type="button"
        aria-label="Previous photo"
        class="pointer-events-auto shrink-0 p-3 bg-white/25 hover:bg-white/50 backdrop-blur-sm text-coffee-bean rounded-full transition-colors duration-200 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>

      <!-- Panel (image + caption) -->
      <div
        id="lightbox-panel"
        class="pointer-events-auto flex-1 flex flex-col items-center mx-3 md:mx-6 min-w-0"
      >
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[88vh] w-auto max-w-full object-contain drop-shadow-2xl"
        />
        <p
          id="lightbox-desc"
          class="mt-4 font-sans text-xs tracking-wide text-coffee-bean/70 bg-white/60 backdrop-blur-sm px-4 py-1.5 text-center"
        ></p>
      </div>

      <!-- Next arrow -->
      <button
        id="lightbox-next"
        type="button"
        aria-label="Next photo"
        class="pointer-events-auto shrink-0 p-3 bg-white/25 hover:bg-white/50 backdrop-blur-sm text-coffee-bean rounded-full transition-colors duration-200 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>

    </div>

    <!-- Close button (top-right, above the controls layer) -->
    <button
      id="lightbox-close"
      type="button"
      aria-label="Close photo viewer"
      class="absolute top-4 right-4 z-10 p-2.5 bg-white/25 hover:bg-white/50 backdrop-blur-sm text-coffee-bean rounded-full transition-colors duration-200 cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

  </div>

  <script>
    const lightbox  = document.getElementById('lightbox')!;
    const backdrop  = document.getElementById('lightbox-backdrop')!;
    const img       = document.getElementById('lightbox-img') as HTMLImageElement;
    const desc      = document.getElementById('lightbox-desc')!;
    const closeBtn  = document.getElementById('lightbox-close')!;
    const prevBtn   = document.getElementById('lightbox-prev')!;
    const nextBtn   = document.getElementById('lightbox-next')!;

    const triggers  = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'));
    let currentIdx  = 0;
    let lastFocused: HTMLElement | null = null;

    function show(idx: number) {
      currentIdx = (idx + triggers.length) % triggers.length;
      const t = triggers[currentIdx];
      img.src          = t.dataset.src  ?? '';
      img.alt          = t.dataset.alt  ?? '';
      desc.textContent = t.dataset.desc ?? '';
    }

    function open(trigger: HTMLElement) {
      lastFocused = trigger;
      show(triggers.indexOf(trigger));
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    // Open
    triggers.forEach(el => el.addEventListener('click', () => open(el)));

    // Close
    backdrop.addEventListener('click', close);
    closeBtn.addEventListener('click', close);

    // Navigate
    prevBtn.addEventListener('click', () => show(currentIdx - 1));
    nextBtn.addEventListener('click', () => show(currentIdx + 1));

    // Keyboard
    document.addEventListener('keydown', e => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape')      { close(); }
      if (e.key === 'ArrowLeft')   { e.preventDefault(); show(currentIdx - 1); }
      if (e.key === 'ArrowRight')  { e.preventDefault(); show(currentIdx + 1); }
    });

    // Focus trap
    lightbox.addEventListener('keydown', e => {
      if (e.key !== 'Tab' || lightbox.classList.contains('hidden')) return;
      const focusable = Array.from(
        lightbox.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])',
        ),
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last  = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    });
  </script>

</BaseLayout>
