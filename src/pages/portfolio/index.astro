---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { galleries } from '../../data/galleries';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/portfolio/*.{jpg,JPG,jpeg,JPEG,webp}',
  { eager: true },
);

const byName: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(modules)) {
  const basename = path.split('/').pop()!;
  byName[basename] = mod.default;
}
---

<BaseLayout
  title="Portfolio"
  description="Browse the Studio.io portfolio — a collection of cherished moments and beautiful love stories."
>
  <div class="max-w-300 mx-auto px-4 sm:px-6">

    <!-- Heading -->
    <div class="pt-10 md:pt-14 pb-8 text-center">
      <h1 class="font-serif text-5xl md:text-6xl text-coffee-bean">Portfolio</h1>
    </div>

    <!-- Card grid -->
    <section aria-label="Portfolio galleries">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
        {galleries.map((gallery, i) => {
          const cover = byName[gallery.cover];
          if (!cover) return null;
          return (
            <a
              href={`/portfolio/${gallery.slug}`}
              class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-flame"
            >
              <div class="overflow-hidden aspect-4/3">
                <Image
                  src={cover}
                  alt=""
                  aria-hidden="true"
                  width={900}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
              </div>
              <div class="pt-4 text-center">
                <h2 class="font-serif text-2xl md:text-3xl text-coffee-bean">{gallery.title}</h2>
                <p class="mt-1 font-sans tracking-widest uppercase text-xs font-semibold text-olive">{gallery.subtitle}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <div class="h-16 md:h-20"></div>

  </div>
</BaseLayout>
