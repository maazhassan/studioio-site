---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/portfolio/*.{jpg,jpeg,JPG,JPEG,webp}',
  { eager: true },
);

const byName: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(modules)) {
  const basename = path.split('/').pop()!;
  byName[basename] = mod.default;
}

const services = [
  {
    title: 'Engagement & Wedding Photography',
    eyebrow: 'Our Signature Service',
    description:
      'Every wedding tells a unique story, and our goal is to preserve it in its entirety. We capture every meaningful glance, heartfelt embrace, and unforgettable celebration from multiple perspectives, ensuring every detail and emotion is beautifully documented.\n\n Our customizable wedding collections are designed around your vision and can include personalized consultation, timeline planning, full-day coverage, optional engagement or bridal sessions, thoughtfully selected photo locations, a curated digital gallery, content creation for the day, instant Polaroid keepsakes on your wedding day, and an online gallery delivered soon after your celebration, allowing you to relive your memories for years to come.',
    price: 'From $150/hr',
    featured: true,
    images: ['rt_12.webp', 'rt_1.webp', 'rt_46.webp'],
  },
  {
    title: 'Event Photography',
    eyebrow: 'Celebrations & Occasions',
    description:
      'Every event tells a unique story. From corporate gatherings and sporting events to academic ceremonies, food and hospitality experiences, and special celebrations, we capture each moment with a documentary-style approach that highlights authentic interactions and the atmosphere of your event. The result is a collection of professional images perfect for preserving memories while elevating your marketing, social media, and promotional content.',
    price: 'From $90/hr',
    featured: false,
    image: '_A741295.jpg',
  },
  {
    title: 'Family Photography',
    eyebrow: 'The People Who Matter Most',
    description:
      'From birthdays, anniversaries, baby showers, and family reunions to holiday gatherings and photoshoots, and other special celebrations, we capture genuine connections, laughter, and memories that make your family unique. Our natural, candid approach creates timeless photographs you\'ll cherish and share for generations.',
    price: 'From $90/hr',
    featured: false,
    image: '_A741283.jpg',
  },
  {
    title: 'Graduation Portraits',
    eyebrow: 'Grad Season',
    description:
      "We\'ll capture your achievement with portraits that reflect your personality, your accomplishment, and your future! This Package will include a 2 hour photoshoot, curated gallery of photos of your pride, personality, family photos, and your school. Perfect for family gifts, announcements and keepsakes.",
    price: 'From $200',
    featured: false,
    image: 'IMG_3752.jpg',
  },
  {
    title: 'Portraits & Headshots',
    eyebrow: 'Individual Sessions',
    description:
      'We\'ll capture your vision in a professional space with portraits that reflect your personality, your accomplishments, and your future! This Package will include a 30 minute to an hour photoshoot in professional and work settings. You will receive a small curated gallery of photos to use for your profession. Perfect for Linkedin, business cards, websites, etc.',
    price: 'From $60',
    featured: false,
    image: '_A740445.jpg',
  },
  {
    title: 'Automotive Photography',
    eyebrow: 'For the Meet',
    description:
      'Every vehicle has a story, and we\'ll capture it with images that showcase its design, personality, and attention to detail. Whether it\'s a personal project, a freshly detailed vehicle, a modified build, a dealership listing, or coverage of a car meet, this package includes a 30-minute to 1-hour photoshoot at carefully selected locations and a curated gallery of professionally edited images. Perfect for collectors, enthusiasts, businesses, online sales, and automotive marketing.',
    price: 'From $80',
    featured: false,
    image: '_A741272.jpg',
  },
];

const [wedding, ...additional] = services;
---

<BaseLayout
  title="Services"
  description="Studio.io photography services — weddings, graduations, events, family sessions, and portraits."
>
  <div class="max-w-6xl mx-auto px-2 sm:px-3">

    <!-- Heading -->
    <div class="pt-10 md:pt-14 pb-10 text-center">
      <h1 class="font-serif text-5xl md:text-6xl text-coffee-bean">Services</h1>
    </div>

    <!-- ── Wedding (featured) ───────────────────────────────────────────────── -->
    <section class="pb-1 md:pb-2">
      <!-- Centered heading + blurb -->
      <div class="text-center max-w-xl mx-auto mb-10">
        <p class="font-sans text-xs tracking-widest uppercase text-olive font-semibold mb-4">
          {wedding.eyebrow}
        </p>
        <h2 class="font-serif text-4xl md:text-5xl text-coffee-bean leading-tight mb-5">
          {wedding.title}
        </h2>
        <p class="font-sans text-sm text-coffee-bean/65 leading-relaxed mb-8 whitespace-pre-line">
          {wedding.description}
        </p>
        <div class="flex flex-wrap justify-center items-center gap-6">
          <span class="font-serif text-2xl text-coffee-bean/80 font-semibold">{wedding.price}</span>
          <a
            href="/contact"
            class="inline-flex items-center gap-2.5 border border-coffee-bean text-coffee-bean px-6 py-3 font-sans text-xs tracking-widest uppercase transition-colors duration-300 hover:border-muted-teal hover:bg-muted-teal hover:text-papaya-whip"
          >
            Inquire
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 3 photos in a row -->
      <div class="grid grid-cols-3 gap-2 sm:gap-3">
        {(wedding.images ?? []).map((filename, i) => (
          <div class="relative aspect-2/3 overflow-hidden">
            <Image
              src={byName[filename]}
              alt="Wedding photography"
              width={480}
              height={720}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="absolute inset-0 w-full h-full object-cover"
            />
          </div>
        ))}
      </div>

    </section>

    <!-- ── Additional services (alternating) ──────────────────────────────── -->
    {additional.map((service, i) => {
      // i=0 Grad → image left; i=1 Event → image right; i=2 Family → left; i=3 Portraits → right
      const imageLeft = i % 2 === 0;
      return (
        <section class={`border-t border-coffee-bean/10 mt-5 pt-5 md:mt-7 md:pt-7`}>
          <!--
            DOM: [image, text] — image top on mobile always.
            md:flex-row-reverse when image should be on the right on desktop.
          -->
          <div class:list={[
            'flex flex-col min-h-75 md:min-h-90',
            imageLeft ? 'md:flex-row' : 'md:flex-row-reverse',
          ]}>

            <!-- Image -->
            <div class="flex-1 relative min-h-60 md:min-h-0 overflow-hidden">
              <Image
                src={byName[service.image!]}
                alt={service.title}
                width={678}
                height={1024}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>

            <!-- Text -->
            <div class="flex-1 flex flex-col justify-center px-8 py-12 md:px-12 md:py-14">
              <p class="font-sans text-xs tracking-widest uppercase text-olive mb-4 font-semibold">
                {service.eyebrow}
              </p>
              <h2 class="font-serif text-3xl md:text-4xl text-coffee-bean leading-tight mb-4">
                {service.title}
              </h2>
              <p class="font-sans text-sm text-coffee-bean/65 leading-relaxed mb-8 max-w-sm">
                {service.description}
              </p>
              <div class="flex flex-wrap items-center gap-6">
                <span class="font-serif text-xl text-coffee-bean/80 font-semibold">{service.price}</span>
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2.5 border border-coffee-bean text-coffee-bean px-6 py-3 font-sans text-xs tracking-widest uppercase transition-colors duration-300 hover:border-muted-teal hover:bg-muted-teal hover:text-papaya-whip"
                >
                  Inquire
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        </section>
      );
    })}

    <div class="h-16 md:h-20"></div>

  </div>
</BaseLayout>
